{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "effort": "high",
  "env": {},
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/check-commit-json.mjs\""
          }
        ]
      }
    ]
  }
}
